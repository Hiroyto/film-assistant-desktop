# Film Assistant Desktop — variáveis de ambiente (copie para .env e preencha).
# .env é gitignored. NENHUM segredo é versionado (AD-08 / DEC-010).

# --- Backend AWS (preservado) ---
REACT_APP_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/<stage>
REACT_APP_WEBSOCKET_URL=wss://<ws-id>.execute-api.us-east-1.amazonaws.com/<stage>
REACT_APP_WEBSOCKET_ENDPOINT=wss://<ws-id>.execute-api.us-east-1.amazonaws.com/<stage>

# --- Freeform (corkboard) ---
# Vazio/ausente = modo MOCK (dados realistas, sem backend) — comportamento atual.
# Setar para o path da rota do Lambda (ex.: "freeform") quando FIL-495 estiver
# deployada na API Gateway acima, para bater no backend real.
REACT_APP_FREEFORM_API_PATH=

# --- Cognito (injeção em build-time; substitui aws-exports.js hard-coded) ---
REACT_APP_AWS_REGION=us-east-1
REACT_APP_COGNITO_POOL_ID=<cognito-user-pool-id>
REACT_APP_COGNITO_APP_CLIENT_ID=<cognito-app-client-id>

# --- Stripe (Tarefa 09 — deep link AD-04) ---
REACT_APP_STRIPE_PORTAL_URL=<stripe-customer-portal-url>

# --- Code signing Windows (RISK-004 — Authenticode/signtool) ---
WINDOWS_CERT_FILE=
WINDOWS_CERT_PASSWORD=

# --- Code signing + notarization macOS (RISK-005 — @electron/notarize) ---
APPLE_IDENTITY=
APPLE_ID=
APPLE_ID_PASSWORD=
APPLE_TEAM_ID=

# --- Distribuição via GitHub Releases (AD-09) ---
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=film-assistant-desktop
GITHUB_TOKEN=

# --- Botões de download desktop na landing WEB (DesktopDownloadButtons) ---
# Repo PÚBLICO de releases que a landing consulta via API do GitHub para achar
# os assets (FilmAssistantSetup.exe / .dmg). Precisam do prefixo REACT_APP_ para
# o CRA embutir no bundle web. Devem apontar para o mesmo repo do publisher acima.
REACT_APP_GITHUB_REPO_OWNER=
REACT_APP_GITHUB_REPO_NAME=film-assistant-desktop
