{
  "name": "film-assistant-desktop",
  "productName": "Film Assistant",
  "version": "1.0.1",
  "private": true,
  "description": "Film Assistant AI — Desktop (Windows + macOS). Shell Electron + renderer React/TipTap + camada local-first.",
  "main": "shell/dist/main.js",
  "homepage": "./",
  "config": {
    "forge": "./forge.config.js"
  },
  "//deps": "Only MAIN-process runtime modules belong here — electron-packager copies production deps into the app. The renderer libs (react, aws-amplify, tiptap, radix, …) are bundled into build/ by craco at build time, so they live in devDependencies and are pruned from the package.",
  "dependencies": {
    "@sentry/electron": "^5.4.0",
    "@types/react-grid-layout": "^1.3.6",
    "better-sqlite3": "^11.10.0",
    "pdfjs-dist": "^6.1.200",
    "react-grid-layout": "^1.5.3",
    "update-electron-app": "^3.2.0"
  },
  "devDependencies": {
    "@aws-amplify/ui-react": "^6.1.6",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-dmg": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.4.0",
    "@electron-forge/publisher-github": "^7.4.0",
    "@electron/notarize": "^2.3.0",
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.47.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/themes": "^3.0.3",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@tiptap/core": "^2.26.1",
    "@tiptap/extension-underline": "^2.26.1",
    "@tiptap/react": "^2.26.1",
    "@tiptap/starter-kit": "^2.26.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jspdf": "^1.3.3",
    "@types/lodash": "^4.17.12",
    "@types/node": "^16.18.79",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "aws-amplify": "^6.0.21",
    "axios": "^1.7.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "depcheck": "^1.4.7",
    "electron": "^31.7.7",
    "express": "^4.21.1",
    "framer-motion": "^12.23.24",
    "jspdf": "^3.0.4",
    "lodash": "^4.17.21",
    "lucide-react": "^0.445.0",
    "postcss": "^8.5.6",
    "prosemirror-model": "^1.25.3",
    "react": "^18.3.1",
    "react-datepicker": "^7.5.0",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-hot-toast": "^2.4.1",
    "react-loading-icons": "^1.1.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.22.3",
    "react-scripts": "5.0.1",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^4.9.5",
    "wait-on": "^8.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "shell:build": "tsc -p shell/tsconfig.json",
    "renderer:build": "craco build",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "desktop:start": "concurrently -k -n cra,electron \"cross-env BROWSER=none craco start\" \"npm run shell:build && wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron shell/dist/main.js\"",
    "desktop:package": "npm run renderer:build && npm run shell:build && electron-forge package",
    "desktop:make": "npm run renderer:build && npm run shell:build && electron-forge make",
    "desktop:publish": "npm run renderer:build && npm run shell:build && electron-forge publish",
    "parity:web": "playwright test -c parity/playwright.config.ts --project=web",
    "parity:desktop": "npm run renderer:build && npm run shell:build && playwright test -c parity/playwright.config.ts --project=desktop",
    "parity:update-golden": "playwright test -c parity/playwright.config.ts --project=web --update-snapshots"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(axios)/)"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
