 },
 {
  "type": "scene",
  "text": "OPENING SCENE"
 },
 {
  "type": "description",
  "text": "Nets hang like weather."
 },
 {
  "type": "character",
  "text": "MARA (V.O.)"
 },
 {
  "type": "parenthetical",
  "text": "(quiet)"
 },
 {
  "type": "parenthetical",
