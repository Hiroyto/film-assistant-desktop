  "type": "scene",
  "text": "EXT. HARBOUR WALL - DAWN"
 },
 {
  "type": "description",
  "text": "Gulls wheel over a slate sea. The tide is out and the boats lie on their sides in the mud, keels to the sky, ropes slack."
 },
 {
  "type": "description",
  "text": "1) Mara walks the wall"
 },
 {
  "type": "description",
  "text": "a) she does not look at the boats"
 },
 {
  "type": "character",
  "text": "BOY"
 },
 {
  "type": "parenthetical",
  "text": "(calling)"
 },
 {
  "type": "dialogue",
  "text": "You missed the tide again!"
 },
 {
  "type": "character",
  "text": "MARA"
 },
 {
  "type": "dialogue",
  "text": "It missed me."
 },
 {
  "type": "dialogue",
  "text": "It always does."
 },
 {
  "type": "description",
  "text": "CLOSE ON THE GAUGE"
 },
 {
